# ============================================================================
# WATERBILLING - PRODUCTION DEPLOYMENT ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in the values before deploying to production
# DO NOT commit this file to version control
# ============================================================================

# ============ CRITICAL SECURITY SETTINGS ============

# SECRET_KEY: Generate a strong, random secret key
# Run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Use the output here (50+ characters, high entropy)
SECRET_KEY=your-secure-random-secret-key-here-minimum-50-characters

# DEBUG Mode (set to False for production)
DEBUG=False

# ============ HOST CONFIGURATION ============

# Allowed hosts for your deployment (comma-separated)
# Example: waterbilling-r92q.onrender.com,yourdomain.com
ALLOWED_HOSTS=waterbilling-r92q.onrender.com

# CSRF and CORS trusted origins (comma-separated)
# Must use HTTPS in production
CSRF_TRUSTED_ORIGINS=https://waterbilling-r92q.onrender.com
CORS_ALLOWED_ORIGINS=https://waterbilling-r92q.onrender.com

# ============ DATABASE CONFIGURATION ============

# Option A: Single Connection URL (e.g., Render, Neon)
# Format: postgresql://username:password@host:port/dbname
# DATABASE_URL=postgresql://username:password@host:5432/waterbilling

# Option B: Individual Variables (Recommended for cPanel)
DB_NAME=cpaneluser_waterbilling
DB_USER=cpaneluser_dbuser
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# ============ EMAIL CONFIGURATION ============

# OTP Email sender configuration
OTP=True
OTP_EMAIL=your-email@gmail.com
OTP_PASSWORD=your-app-specific-password

# ============ PAYMENT GATEWAY ============

# Stripe API Keys
STRIPE_PUBLIC_KEY=pk_live_your_public_key
STRIPE_SECRET_KEY=sk_live_your_secret_key

# M-Pesa Daraja (C2B Paybill). Use sandbox values until Go Live.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox: Use test shortcode 174379. Production: Use your actual Paybill number
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_ENV=sandbox
# Public HTTPS origin, no trailing slash, e.g. https://your-app.onrender.com
MPESA_CALLBACK_BASE_URL=
# Optional path secret: callbacks become /payments/mpesa/<secret>/confirmation/
MPESA_CALLBACK_SECRET=
# Optional comma-separated allowlist (leave empty in sandbox)
MPESA_ALLOWED_IPS=

# Celery / Redis (Render worker). On cPanel, cron `process_pending_payments` instead.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============ EXTERNAL SERVICES ============

# Twilio SMS Configuration (if needed)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token

# Dropbox Configuration (if needed)
DROPBOX_TOKEN=your_dropbox_token

# ============ ADDITIONAL SETTINGS ============

# Create superuser automatically on first deploy
# Set to "1" to enable
CREATE_SUPERUSER=0

# ============ SECURITY NOTES ============
# 1. Generate SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 2. Use environment variables, never hardcode secrets
# 3. Enable HTTPS (provided by Render)
# 4. Monitor logs for security issues
# 5. Keep dependencies updated regularly
# 6. Enable two-factor authentication in admin panel
